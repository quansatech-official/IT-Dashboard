# =====================
# DATABASE
# =====================
POSTGRES_DB=it_dashboard
POSTGRES_USER=it_user
POSTGRES_PASSWORD=change-me-long-random-postgres-password
POSTGRES_PORT=5432
POSTGRES_BIND_IP=127.0.0.1

# =====================
# BACKEND
# =====================
BACKEND_PORT=9873
BACKEND_BIND_IP=127.0.0.1
DATABASE_URL=postgresql+psycopg2://it_user:change-me-long-random-postgres-password@db:5432/it_dashboard
VITE_API_URL=http://backend:8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONNECT_TIMEOUT_SECONDS=6
INTERNAL_AI_STREAM_TIMEOUT_SECONDS=300
OLLAMA_REQUEST_KEEP_ALIVE=30m
OLLAMA_STREAM_ENABLED=0
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_THREAD=8
INTERNAL_AI_MAX_TOKENS=1200
OLLAMA_PROMPT_MAX_CHARS=12000
OLLAMA_MAX_TOKENS_HARD_LIMIT=320
OLLAMA_SLOW_REQUEST_MS=25000
OLLAMA_RESPONSE_CACHE_TTL_SECONDS=180
OLLAMA_RESPONSE_CACHE_MAX_ENTRIES=400
OLLAMA_MISSING_MODEL_TTL_SECONDS=600
DB_STARTUP_RETRY_ATTEMPTS=30
DB_STARTUP_RETRY_DELAY_SECONDS=2
CUSTOMER_META_HUB_URL=http://meta-hub:8010
CUSTOMER_META_HUB_ENABLED=1
CUSTOMER_META_HUB_TIMEOUT_SECONDS=8
META_HUB_INTERNAL_TOKEN=change-me-long-random-meta-hub-token
INFRA_DISCOVERY_API_URL=
INFRA_DISCOVERY_TOKEN=change-me-long-random-discovery-token
CORS_ALLOW_ORIGINS=https://dashboard.example.com

# =====================
# FRONTEND
# =====================
FRONTEND_PORT=7000
FRONTEND_BIND_IP=0.0.0.0
MOBILE_FRONTEND_PORT=7001
MOBILE_FRONTEND_BIND_IP=127.0.0.1

# =====================
# META HUB (CUSTOMER DEVELOPMENT SNAPSHOT)
# =====================
META_HUB_PORT=8010
META_HUB_BIND_IP=127.0.0.1
META_HUB_BACKEND_URL=http://backend:8000
META_HUB_REFRESH_SECONDS=300
META_HUB_TIMEOUT_SECONDS=120
META_HUB_CACHE_FILE=/data/customer_development_snapshot.json
META_HUB_SOURCE_INCLUDE_INACTIVE=1
META_HUB_SOURCE_FULL=1
META_HUB_AUTO_REFRESH=1
META_HUB_RMM_TIMEOUT_SECONDS=30
META_HUB_MAC_VENDOR_LOOKUP_ENABLED=1
META_HUB_MAC_VENDOR_API_TEMPLATE=https://api.macvendors.com/{mac}
META_HUB_MAC_VENDOR_TIMEOUT_SECONDS=1.8
META_HUB_MAC_VENDOR_MAX_LOOKUPS_PER_REFRESH=30
META_HUB_MAC_VENDOR_CACHE_TTL_SECONDS=2592000

# =====================
# OLLAMA
# =====================
OLLAMA_PORT=11434
OLLAMA_BIND_IP=127.0.0.1
OLLAMA_PRELOAD_MODELS=qwen3:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_THREAD=14
OLLAMA_CONTEXT_LENGTH=2048

# =====================
# MARKETPLACE IMPORT
# =====================
MARKETPLACE_IMPORT_PORT=9876
MARKETPLACE_IMPORT_BIND_IP=127.0.0.1

# =====================
# OIDC / OAUTH2 PROXY
# =====================
NEXTCLOUD_OIDC_CLIENT_ID=change-me-client-id
NEXTCLOUD_OIDC_CLIENT_SECRET=change-me-client-secret
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-byte-base64-secret
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=false
