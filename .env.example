# =====================
# DATABASE
# =====================
POSTGRES_DB=it_dashboard
POSTGRES_USER=it_user
POSTGRES_PASSWORD=it_secret_password
POSTGRES_PORT=5432

# =====================
# BACKEND
# =====================
BACKEND_PORT=9873
DATABASE_URL=postgresql+psycopg2://it_user:it_secret_password@db:5432/it_dashboard
VITE_API_URL=http://backend:8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:latest

# =====================
# FRONTEND
# =====================
FRONTEND_PORT=7000

# =====================
# OLLAMA
# =====================
OLLAMA_PORT=11434
OLLAMA_PRELOAD_MODELS=llama3.1:latest
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_THREAD=14
OLLAMA_CONTEXT_LENGTH=2048
